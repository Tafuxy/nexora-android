<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nexora" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/nexora_bg</item>
        <item name="android:navigationBarColor">@color/nexora_bg</item>
        <item name="android:windowBackground">@color/nexora_bg</item>
        <item name="colorPrimary">@color/nexora_accent</item>
        <item name="colorAccent">@color/nexora_accent</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.Nexora.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nexora_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">500</item>
        <item name="postSplashScreenTheme">@style/Theme.Nexora</item>
    </style>
</resources>
