<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nexora" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/nexora_bg</item>
        <item name="android:navigationBarColor">@color/nexora_bg</item>
        <item name="android:windowBackground">@color/nexora_bg</item>
        <item name="android:colorAccent">@color/nexora_accent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.Nexora.Splash" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/nexora_bg</item>
        <item name="android:navigationBarColor">@color/nexora_bg</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
